<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Asteria" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/asteria_accent</item>
        <item name="colorPrimaryDark">@color/asteria_accent</item>
        <item name="colorAccent">@color/asteria_accent</item>
        <item name="android:windowBackground">@color/asteria_bg</item>
        <!-- ФИКС "верх/низ не совпадают с темой внутри приложения": раньше
             statusBarColor был жёстко зашит в акцентный фиолетовый, а
             navigationBarColor вообще не задавался (система подставляла
             свой дефолт — обычно чёрный) — из-за этого у человека со
             светлой темой низ экрана оставался чёрным независимо ни от
             чего. Здесь — только стартовые значения на самую первую долю
             секунды загрузки, ДО того как страница успеет сообщить свой
             реальный цвет через JS-мост (см. setSystemBarColors в
             WebAppInterface.java и updateNativeSystemBars() в
             public/app.js, вызывается при каждой смене темы). -->
        <item name="android:statusBarColor" tools:targetApi="21">@color/asteria_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/asteria_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
